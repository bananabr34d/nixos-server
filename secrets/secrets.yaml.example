# Template only — Nix does not read this file.
#
# When you turn on Harmonia (homelab.cache.enable = true):
#   nix-store --generate-binary-cache-key primary /tmp/secret /tmp/public
#   # put /tmp/secret in secrets.yaml as harmonia_key (via sops)
#   # put the public line into modules/nixos/core/nix trusted-public-keys
#
# harmonia_key: |
#   primary:...
#
# Never commit plaintext. See docs/INSTALL.md.
